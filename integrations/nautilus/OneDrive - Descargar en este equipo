#!/usr/bin/env python3
"""
Nautilus Script: Descargar en este equipo (OneDrive)
Permite seleccionar uno o varios archivos/carpetas en Nautilus y descargarlos para uso sin conexión.
"""

import os
import sys
import subprocess
import unicodedata

# Add extensions directory to path to locate onedrive_core
_ext_dir = os.path.expanduser("~/.local/share/nautilus-python/extensions")
if _ext_dir not in sys.path:
    sys.path.insert(0, _ext_dir)
_local_dir = os.path.dirname(os.path.abspath(__file__))
if _local_dir not in sys.path:
    sys.path.insert(0, _local_dir)

import onedrive_core

raw_paths = os.environ.get("NAUTILUS_SCRIPT_SELECTED_FILE_PATHS", "")
selected_paths = [p for p in raw_paths.splitlines() if p]
if not selected_paths:
    selected_paths = [p for p in sys.argv[1:] if p]

if not selected_paths:
    sys.exit(0)

cache_base = onedrive_core.get_cache_base()
if not os.path.isdir(cache_base):
    sys.exit(0)

active_fuse_mounts = onedrive_core.get_active_fuse_mounts()

# Discover active mounts
mounts = {}
try:
    entries = os.listdir(cache_base)
except OSError:
    entries = []

for entry in entries:
    if entry in ("CacheStorage", "WebKitCache"):
        continue
    cp = os.path.join(cache_base, entry)
    token = os.path.join(cp, "auth_tokens.json")
    if os.path.isdir(cp) and os.path.isfile(token):
        try:
            mp = onedrive_core.unescape_systemd(entry)
            if os.path.isdir(mp) and (mp in active_fuse_mounts):
                mounts[mp] = {
                    "cache_dir": cp,
                    "content_dir": os.path.join(cp, "content"),
                    "db_path": os.path.join(cp, "onedriver.db"),
                    "encoded": entry
                }
        except Exception:
            pass

if not mounts:
    sys.exit(0)

selected_dirs = {p for p in selected_paths if os.path.isdir(p)}
pruned_paths = [
    p for p in selected_paths
    if not any(p != d and p.startswith(d + "/") for d in selected_dirs)
]

downloaded_count = 0
already_cached_count = 0
failed_count = 0
buf = bytearray(1024 * 1024)
mv = memoryview(buf)
locks = {}
lock_failed = False

def walk_error(err):
    global failed_count
    failed_count += 1

try:
    for target in pruned_paths:
        if not target:
            continue

        matched_mp = None
        matched_info = None
        for mp in sorted(mounts.keys(), key=len, reverse=True):
            if target == mp or target.startswith(mp + "/"):
                matched_mp = mp
                matched_info = mounts[mp]
                break

        if not matched_mp:
            continue

        content_dir = matched_info["content_dir"]
        db_path = matched_info["db_path"]
        encoded = matched_info["encoded"]

        if not os.path.isdir(content_dir) or not os.path.isfile(db_path):
            continue

        if encoded not in locks:
            lf, ok = onedrive_core.acquire_lock(encoded, timeout=5.0)
            if not ok:
                lock_failed = True
                break
            locks[encoded] = lf

        snapshot = onedrive_core.read_bbolt_db(db_path, content_dir)
        path_to_item = snapshot.get("path_to_item", {})
        is_dir = (target == matched_mp) or os.path.isdir(target)

        if is_dir:
            for root_dir, _, filenames in os.walk(target, onerror=walk_error):
                for fn in filenames:
                    fp = os.path.join(root_dir, fn)
                    rel_f = unicodedata.normalize("NFC", os.path.relpath(fp, matched_mp))
                    item = path_to_item.get(rel_f)
                    cid = item["id"] if item else None
                    remote_size = item["size"] if item else 0
                    expected_hash = item.get("hash") if item else None

                    preset_cached = bool(cid and onedrive_core.is_item_cached(content_dir, cid, remote_size, expected_hash, item_info=item))
                    try:
                        with open(fp, "rb") as f:
                            while f.readinto(mv):
                                pass
                        if preset_cached:
                            already_cached_count += 1
                        else:
                            downloaded_count += 1
                    except Exception:
                        failed_count += 1
        else:
            rel_f = unicodedata.normalize("NFC", os.path.relpath(target, matched_mp))
            item = path_to_item.get(rel_f)
            cid = item["id"] if item else None
            remote_size = item["size"] if item else 0
            expected_hash = item.get("hash") if item else None

            preset_cached = bool(cid and onedrive_core.is_item_cached(content_dir, cid, remote_size, expected_hash, item_info=item))
            try:
                with open(target, "rb") as f:
                    while f.readinto(mv):
                        pass
                if preset_cached:
                    already_cached_count += 1
                else:
                    downloaded_count += 1
            except Exception:
                failed_count += 1
finally:
    for lf in locks.values():
        onedrive_core.release_lock(lf)

if lock_failed:
    try:
        subprocess.run(["notify-send", "-a", "OneDrive", "-i", "dialog-warning", "Descarga de OneDrive", "La cuenta está ocupada por otra operación."])
    except Exception:
        pass
    sys.exit(1)

if downloaded_count > 0 and failed_count == 0:
    msg = f"Se descargaron {downloaded_count} archivo(s) para uso sin conexión."
    icon = "onedrive-custom-synced"
elif downloaded_count > 0 and failed_count > 0:
    msg = f"Se descargaron {downloaded_count} archivo(s), pero fallaron {failed_count}."
    icon = "dialog-warning"
elif failed_count > 0:
    msg = f"Falló la descarga de {failed_count} archivo(s). Verifique la conexión con OneDrive."
    icon = "dialog-error"
else:
    msg = "Los archivos seleccionados ya estaban descargados en este equipo."
    icon = "onedrive-custom-synced"

try:
    subprocess.run(["notify-send", "-a", "OneDrive", "-i", icon, "Descarga de OneDrive", msg])
except Exception:
    pass
