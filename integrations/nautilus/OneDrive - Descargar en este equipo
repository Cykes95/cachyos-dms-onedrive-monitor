#!/usr/bin/env python3
"""
Nautilus Script: Descargar en este equipo (OneDrive)
Permite seleccionar uno o varios archivos/carpetas en Nautilus y descargarlos para uso sin conexión.
"""

import os
import sys
import subprocess
import mmap
import re
import fcntl

raw_paths = os.environ.get("NAUTILUS_SCRIPT_SELECTED_FILE_PATHS", "")
selected_paths = [p for p in raw_paths.splitlines() if p]
if not selected_paths:
    selected_paths = [p for p in sys.argv[1:] if p]

if not selected_paths:
    sys.exit(0)

home_dir = os.path.expanduser("~")
cache_base = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.join(home_dir, ".cache")), "onedriver")
config_file = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(home_dir, ".config")), "onedriver/config.yml")

if os.path.isfile(config_file):
    try:
        with open(config_file, "r", encoding="utf-8") as f:
            for line in f:
                if line.strip().startswith("cacheDir:"):
                    val = line.split(":", 1)[1].strip().strip("\"'")
                    if val.startswith("~"):
                        cache_base = os.path.expanduser(val)
                    elif val.startswith("/"):
                        cache_base = val
                    break
    except Exception:
        pass

if not os.path.isdir(cache_base):
    sys.exit(0)

def _unescape_systemd(encoded: str) -> str:
    result = []
    i = 0
    n = len(encoded)
    while i < n:
        if encoded[i:i+2] == "\\x":
            try:
                result.append(chr(int(encoded[i+2:i+4], 16)))
                i += 4
                continue
            except Exception:
                pass
        if encoded[i] == "-":
            result.append("/")
        else:
            result.append(encoded[i])
        i += 1
    path = "".join(result)
    if not path.startswith("/"):
        path = "/" + path
    return path

# Discovered mounts
mounts = {}
for name in os.listdir(cache_base):
    if name in ("CacheStorage", "WebKitCache"):
        continue
    cp = os.path.join(cache_base, name)
    token = os.path.join(cp, "auth_tokens.json")
    if os.path.isdir(cp) and os.path.isfile(token):
        try:
            mp = _unescape_systemd(name)
            if os.path.isdir(mp):
                mounts[mp] = {
                    "cache_dir": cp,
                    "content_dir": os.path.join(cp, "content"),
                    "db_path": os.path.join(cp, "onedriver.db")
                }
        except Exception:
            pass

pattern = re.compile(rb'\{"id":"([A-Za-z0-9!_-]+)","name":"([^"]+)".*?"parentReference":\{.*?"path":"([^"]*)".*?,"(file|folder)":', re.DOTALL)
db_cache = {}

def get_db_info(db_path):
    if db_path in db_cache:
        return db_cache[db_path]
    path_to_id = {}
    if not os.path.isfile(db_path) or os.path.getsize(db_path) == 0:
        return path_to_id
    try:
        with open(db_path, "rb") as f:
            with mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ) as mm:
                matches = pattern.findall(mm)
        for item_id_b, name_b, parent_b, kind_b in matches:
            if kind_b != b"file":
                continue
            clean_parent = parent_b.decode("utf-8", errors="ignore").replace("/drive/root:", "")
            clean_name = name_b.decode("utf-8", errors="ignore")
            item_rel = os.path.normpath(os.path.join(clean_parent.lstrip("/"), clean_name))
            item_id = item_id_b.decode("utf-8", errors="ignore")
            path_to_id[item_rel] = item_id
    except Exception:
        pass
    db_cache[db_path] = path_to_id
    return path_to_id

selected_dirs = {p for p in selected_paths if os.path.isdir(p)}
pruned_paths = [
    p for p in selected_paths
    if not any(p != d and p.startswith(d + "/") for d in selected_dirs)
]

downloaded_count = 0
buf = bytearray(1024 * 1024)
mv = memoryview(buf)
locks = {}

try:
    for target in pruned_paths:
        if not target:
            continue

        # Match mount
        matched_mp = None
        matched_info = None
        for mp in sorted(mounts.keys(), key=len, reverse=True):
            if target == mp or target.startswith(mp + "/"):
                matched_mp = mp
                matched_info = mounts[mp]
                break

        if not matched_mp:
            continue

        content_dir = matched_info["content_dir"]
        db_path = matched_info["db_path"]
        cache_dir = matched_info["cache_dir"]
        if not os.path.isdir(content_dir) or not os.path.isfile(db_path):
            continue

        if cache_dir not in locks:
            try:
                lf = open(os.path.join(cache_dir, ".lock"), "w")
                fcntl.flock(lf.fileno(), fcntl.LOCK_EX)
                locks[cache_dir] = lf
            except Exception:
                pass

        cached_ids = set()
        if os.path.isdir(content_dir):
            try:
                cached_ids = set(os.listdir(content_dir))
            except Exception:
                pass

        path_to_id = get_db_info(db_path)
        is_dir = (target == matched_mp) or os.path.isdir(target)

        if is_dir:
            for root_dir, _, filenames in os.walk(target):
                for fn in filenames:
                    fp = os.path.join(root_dir, fn)
                    rel_f = os.path.relpath(fp, matched_mp)
                    cid = path_to_id.get(rel_f)
                    if cid and cid in cached_ids:
                        continue
                    try:
                        with open(fp, "rb") as f:
                            while f.readinto(mv):
                                pass
                        downloaded_count += 1
                    except Exception:
                        pass
        else:
            rel_f = os.path.relpath(target, matched_mp)
            cid = path_to_id.get(rel_f)
            if cid and cid in cached_ids:
                continue
            try:
                with open(target, "rb") as f:
                    while f.readinto(mv):
                        pass
                downloaded_count += 1
            except Exception:
                pass
finally:
    for lf in locks.values():
        try:
            fcntl.flock(lf.fileno(), fcntl.LOCK_UN)
            lf.close()
        except Exception:
            pass

if downloaded_count > 0:
    msg = f"Se descargaron {downloaded_count} archivo(s) para uso sin conexión."
else:
    msg = "Los archivos seleccionados ya estaban descargados en este equipo."

try:
    subprocess.run(["notify-send", "-a", "OneDrive", "-i", "onedrive-custom-synced", "Descarga de OneDrive", msg])
except Exception:
    pass
