#!/usr/bin/env python3
"""
Nautilus Script: Liberar espacio local de OneDrive
Permite seleccionar uno o varios archivos/carpetas en Nautilus y liberar su espacio local.
"""

import os
import sys
import subprocess

selected_paths = os.environ.get("NAUTILUS_SCRIPT_SELECTED_FILE_PATHS", "").strip().split("\n")
if not selected_paths or selected_paths == [""]:
    selected_paths = sys.argv[1:]

if not selected_paths or selected_paths == [""]:
    sys.exit(0)

cache_base = os.path.expanduser("~/.cache/onedriver")
config_file = os.path.expanduser("~/.config/onedriver/config.yml")
if os.path.isfile(config_file):
    try:
        with open(config_file, "r", encoding="utf-8") as f:
            for line in f:
                if line.strip().startswith("cacheDir:"):
                    val = line.split(":", 1)[1].strip()
                    if val.startswith("~"):
                        cache_base = os.path.expanduser(val)
                    elif val.startswith("/"):
                        cache_base = val
                    break
    except Exception:
        pass

if not os.path.isdir(cache_base):
    sys.exit(0)

import mmap
import re

def _unescape_systemd(encoded: str) -> str:
    result = []
    i = 0
    n = len(encoded)
    while i < n:
        if encoded[i:i+4].startswith(r"\x"):
            try:
                result.append(chr(int(encoded[i+2:i+4], 16)))
                i += 4
                continue
            except Exception:
                pass
        if encoded[i] == "-":
            result.append("/")
        else:
            result.append(encoded[i])
        i += 1
    path = "".join(result)
    if not path.startswith("/"):
        path = "/" + path
    return path

# Discovered mounts
mounts = {}
for name in os.listdir(cache_base):
    if name in ("CacheStorage", "WebKitCache"):
        continue
    cp = os.path.join(cache_base, name)
    token = os.path.join(cp, "auth_tokens.json")
    if os.path.isdir(cp) and os.path.isfile(token):
        try:
            mp = _unescape_systemd(name)
            if os.path.isdir(mp):
                mounts[mp] = {
                    "cache_dir": cp,
                    "content_dir": os.path.join(cp, "content"),
                    "db_path": os.path.join(cp, "onedriver.db")
                }
        except Exception:
            pass

pattern = re.compile(rb'\{"id":"([A-Za-z0-9!_-]+)","name":"([^"]+)".*?"parentReference":\{.*?"path":"([^"]*)"', re.DOTALL)
db_cache = {}

def get_db_items(db_path):
    if db_path in db_cache:
        return db_cache[db_path]
    items = []
    try:
        with open(db_path, "rb") as f:
            with mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ) as mm:
                matches = pattern.findall(mm)
        for item_id_b, name_b, parent_b in matches:
            clean_parent = parent_b.decode("utf-8", errors="ignore").replace("/drive/root:", "")
            clean_name = name_b.decode("utf-8", errors="ignore")
            item_rel = os.path.normpath(os.path.join(clean_parent.lstrip("/"), clean_name))
            item_id = item_id_b.decode("utf-8", errors="ignore")
            items.append((item_id, item_rel))
    except Exception:
        pass
    db_cache[db_path] = items
    return items

freed_count = 0

for target in selected_paths:
    target = target.strip()
    if not target:
        continue

    # Find matching mount (longest mountpoint first)
    matched_mp = None
    matched_info = None
    for mp in sorted(mounts.keys(), key=len, reverse=True):
        if target == mp or target.startswith(mp + "/"):
            matched_mp = mp
            matched_info = mounts[mp]
            break

    if not matched_mp:
        continue

    content_dir = matched_info["content_dir"]
    db_path = matched_info["db_path"]
    if not os.path.isdir(content_dir) or not os.path.isfile(db_path):
        continue

    rel_path = os.path.relpath(target, matched_mp)
    if rel_path == ".":
        continue

    db_items = get_db_items(db_path)
    is_dir = os.path.isdir(target)
    target_prefix = rel_path + "/"

    for item_id, item_rel in db_items:
        should_free = False
        if is_dir and item_rel.startswith(target_prefix):
            should_free = True
        elif not is_dir and item_rel == rel_path:
            should_free = True

        if should_free:
            cached_file = os.path.join(content_dir, item_id)
            if os.path.isfile(cached_file):
                try:
                    os.remove(cached_file)
                    freed_count += 1
                except Exception:
                    pass

if freed_count > 0:
    msg = f"Se ha liberado el espacio local de {freed_count} archivo(s)."
else:
    msg = "Los elementos seleccionados ya estaban solo en la nube."

try:
    subprocess.run(["notify-send", "-a", "OneDrive", "-i", "onedrive-custom-cloud", "Espacio liberado", msg])
except Exception:
    pass
