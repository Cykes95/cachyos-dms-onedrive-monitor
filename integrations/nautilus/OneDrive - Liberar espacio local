#!/usr/bin/env python3
"""
Nautilus Script: Liberar espacio local de OneDrive
Informa al usuario de forma segura que debe usar «Vaciar caché» desde el panel de OneDrive
para proteger la integridad de datos y evitar inconsistencias o pérdidas de subidas pendientes.
"""

import os
import sys
import subprocess

raw_paths = os.environ.get("NAUTILUS_SCRIPT_SELECTED_FILE_PATHS", "")
selected_paths = [p for p in raw_paths.splitlines() if p]
if not selected_paths:
    selected_paths = [p for p in sys.argv[1:] if p]

try:
    subprocess.run([
        "notify-send", "-a", "OneDrive", "-i", "dialog-information",
        "OneDrive: Liberar espacio local",
        "Para garantizar la integridad de los datos y evitar inconsistencias, utilice la opción «Vaciar caché» desde el panel de OneDrive."
    ])
except Exception:
    pass

sys.exit(0)
