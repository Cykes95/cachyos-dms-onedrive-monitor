{
  "id": "onedriverMonitor",
  "name": "OneDrive Monitor",
  "description": "Monitor and control multiple onedriver mounts, cache usage, autostart, transfers and service health",
  "version": "1.2.1",
  "author": "Community",
  "type": "widget",
  "capabilities": ["dankbar-widget", "control-center", "monitoring", "filesystem"],
  "component": "./OneDriveMonitor.qml",
  "settings": "./Settings.qml",
  "icon": "cloud_sync",
  "requires_dms": ">=1.6.0",
  "dependencies": ["onedriver", "nautilus", "python3", "systemctl", "journalctl", "findmnt", "fusermount3", "xdg-open", "timeout", "flock", "realpath"],
  "permissions": ["settings_read", "settings_write", "process"]
}
